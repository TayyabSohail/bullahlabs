# App (required). Production domain: https://bullahlabs.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Bullah Labs

# Contact form delivery via Resend (https://resend.com) - required for the form to send.
# Without it, submissions are only logged on the server (and stored in Supabase if configured).
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=hello@bullahlabs.com
# Must be a verified sender on your Resend domain. Until the domain is verified
# in Resend, use their shared sender: "Bullah Labs <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Bullah Labs <onboarding@resend.dev>"

# Supabase - optional. When set, contact submissions are stored in `contact_messages`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cal.com booking handle as "username" or "username/event", e.g. bullah-labs/intro.
# This is the handle from your booking page URL - NOT a Cal.com API key.
# Anything starting with cal_live_ / cal_test_ is ignored, because it would
# otherwise render a button pointing at a dead https://cal.com/cal_live_... URL.
# Optional: leave empty to hide the booking calendar entirely.
NEXT_PUBLIC_CAL_LINK=

# PostHog analytics - optional, only loads after cookie consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Where the Conscious AI course is hosted (full URL). Optional: while empty,
# every "Watch the course" link opens the contact form to request access.
NEXT_PUBLIC_COURSE_URL=
